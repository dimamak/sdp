# dailypost secrets — copy to .env (chmod 600). Git-ignored.

# Telegram harvester (my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=

# Telegram bot (from @BotFather) + your own chat id (wizard captures it)
TG_BOT_TOKEN=
TG_ALLOWED_CHAT_ID=

# WAHA (self-generated random key, same value passed to the WAHA container)
WAHA_API_KEY=

# LinkedIn app (Share on LinkedIn + Sign In with LinkedIn products)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Gemini API key for post illustrations (aistudio.google.com/apikey).
# The image models need billing enabled on the key's project — a free-tier key
# authenticates fine but returns 429 on every image request.
GEMINI_API_KEY=

# Optional: Groq for cheap cloud transcription fallback (Phase 2)
GROQ_API_KEY=

# Long-lived Claude Code token, from `claude setup-token`. STRONGLY recommended
# when anything else runs claude under the same user (an IDE/coding-agent session,
# another service): the interactive login's OAuth token is ROTATED on refresh, so
# two users of one ~/.claude/.credentials.json keep revoking each other and calls
# fail intermittently with "OAuth access token has been revoked".
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: use the Anthropic API instead of local claude CLI credentials
# (independent of the above, but billed per token rather than by subscription)
# ANTHROPIC_API_KEY=
